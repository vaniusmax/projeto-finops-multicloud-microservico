# Para o primeiro deploy: make base-build && make base-push (em finops-traefik-stack/)
# Depois: make backend-build-hub IMAGE_TAG=<versão>
FROM vaniusoliveira/finops-base-clls:latest

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    UV_SYSTEM_PYTHON=1

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --no-dev
ENV PATH="/app/.venv/bin:${PATH}"

COPY . .

USER app

EXPOSE 8000

CMD ["uvicorn", "finops_api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", "--proxy-headers"]
