TZ=America/Sao_Paulo

BACKEND_IMAGE=vaniusoliveira/finops-backend:latest
DATABASE_URL=postgresql+psycopg2://finops:finops123@finops-db:5432/finops

APP_ENV=prod
FINOPS_DEBUG=false
API_PREFIX=/api/v1
AUTO_INGEST_ON_REQUEST=true

FINOPS_API_HOST=finops.local
TRAEFIK_ENTRYPOINTS=web

CORS_ORIGINS=http://finops.local
CORS_ORIGIN_REGEX=^https?://finops\.local$
AUTH_FRONTEND_BASE_URL=http://finops.local

AUTH_ALLOWED_EMAIL_DOMAINS=algar.com.br,algartelecom.com.br
AUTH_VERIFY_EMAIL_PATH=/verify-email
AUTH_SESSION_TTL_HOURS=12
AUTH_VERIFICATION_TTL_HOURS=24
AUTH_EMAIL_FROM=finops@algar.com.br
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=

AWS_PROFILE=
AWS_TENANTS=
AWS_CLI_PATH=aws

AZURE_MANAGEMENT_GROUP_ID=
AZURE_TENANTS=
AZURE_API_VERSION=2023-11-01
AZURE_CLI_PATH=az

OCI_TENANT_ID=
OCI_PROFILE=DEFAULT
OCI_TENANTS=
OCI_REGION=sa-saopaulo-1
OCI_CLI_PATH=oci
OCI_COMPARTMENT_DEPTH=6

TARGET_MONTHLY_BRL=0
TARGET_WEEKLY_BRL=0
TARGET_MONTHLY_USD=0
TARGET_WEEKLY_USD=0
MONTHLY_TARGETS_JSON=

CURRENCY_RATE_SYNC_ON_REQUEST=true
CURRENCY_RATE_PROVIDER_URL=https://economia.awesomeapi.com.br/json/daily/USD-BRL/1
CURRENCY_RATE_TIMEOUT_SECONDS=10
CURRENCY_RATE_AGNO_ENABLED=false
CURRENCY_RATE_YFINANCE_ENABLED=true
CURRENCY_RATE_YFINANCE_SYMBOL=BRL=X
