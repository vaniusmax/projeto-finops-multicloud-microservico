# Local (maquina dev): use *.local-dev
# Producao (AWS): troque para *.local

TZ=America/Sao_Paulo

BACKEND_IMAGE=vaniusoliveira/finops-backend:latest
DATABASE_URL=postgresql+psycopg2://finops:finops123@finops-db:5432/finops

APP_ENV=prod
FINOPS_DEBUG=false
API_PREFIX=/api/v1
AUTO_INGEST_ON_REQUEST=true

FINOPS_API_HOST=finops.local-dev
TRAEFIK_DASHBOARD_HOST=traefik.local-dev
PGADMIN_HOST=pgadmin.local-dev
PORTAINER_HOST=portainer.local-dev
TRAEFIK_ENTRYPOINTS=web,websecure
AWS_HOST_CREDENTIALS_DIR=/home/ubuntu/.aws
AZURE_HOST_CREDENTIALS_DIR=/home/ubuntu/.azure
OCI_HOST_CREDENTIALS_DIR=/home/ubuntu/.oci
OCI_CONTAINER_CREDENTIALS_DIR=/home/ubuntu/.oci
OCI_CLI_CONFIG_FILE=/home/ubuntu/.oci/config

CORS_ORIGINS=http://finops.local-dev
CORS_ORIGIN_REGEX=^https?://finops\.(local-dev|local)$
AUTH_FRONTEND_BASE_URL=http://finops.local-dev

AUTH_ALLOWED_EMAIL_DOMAINS=algar.com.br,algartelecom.com.br
AUTH_VERIFY_EMAIL_PATH=/verify-email
AUTH_SESSION_TTL_HOURS=12
AUTH_VERIFICATION_TTL_HOURS=24
AUTH_EMAIL_FROM=finops@algar.com.br
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_BASE=

AWS_PROFILE=
AWS_TENANTS=
AWS_CLI_PATH=aws

AZURE_MANAGEMENT_GROUP_ID=
AZURE_TENANTS=mg-algar-finops
AZURE_API_VERSION=2023-11-01
AZURE_CLI_PATH=az

OCI_TENANT_ID=
OCI_PROFILE=DEFAULT
OCI_TENANTS=OCI-TENANT-OCVS,OCI-TENANT-ORACLE-SOA
OCI_REGION=sa-saopaulo-1
OCI_CLI_PATH=oci
OCI_COMPARTMENT_DEPTH=6
TENANT_CONFIGS_JSON={"oci":{"OCI-TENANT-OCVS":{"profile":"OCI-TENANT-OCVS","tenant_id":"<OCVS_TENANCY_OCID>"},"OCI-TENANT-ORACLE-SOA":{"profile":"OCI-TENANT-ORACLE-SOA","tenant_id":"<ORACLE_SOA_TENANCY_OCID>"}}}

TARGET_MONTHLY_BRL=331894.50
TARGET_WEEKLY_BRL=82973.625
TARGET_MONTHLY_USD=57000
TARGET_WEEKLY_USD=5500
MONTHLY_TARGETS_JSON={"aws":{"2026-01":138531.58,"2026-02":138531.58,"2026-03":138531.58,"2026-04":138531.58,"2026-05":138531.58,"2026-06":138531.58,"2026-07":138531.58,"2026-08":138531.58,"2026-09":138531.58,"2026-10":138531.58,"2026-11":138531.58,"2026-12":138531.58},"azure":{"2026-01":231437.64,"2026-02":231437.64,"2026-03":231437.64,"2026-04":231437.64,"2026-05":231437.64,"2026-06":231437.64,"2026-07":231437.64,"2026-08":231437.64,"2026-09":231437.64,"2026-10":231437.64,"2026-11":231437.64,"2026-12":231437.64},"oci":{"2026-01":331894.50,"2026-02":331894.50,"2026-03":331894.50,"2026-04":331894.50,"2026-05":331894.50,"2026-06":331894.50,"2026-07":331894.50,"2026-08":331894.50,"2026-09":331894.50,"2026-10":331894.50,"2026-11":331894.50,"2026-12":331894.50}}

CURRENCY_RATE_SYNC_ON_REQUEST=true
CURRENCY_RATE_PROVIDER_URL=https://economia.awesomeapi.com.br/json/daily/USD-BRL/1
CURRENCY_RATE_TIMEOUT_SECONDS=10
